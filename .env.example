# ──────────────────────────────────────────────
# Backend Environment Variables (.env.example)
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# On Render/Railway, set these as environment variables in the dashboard.

# SECRET_KEY (REQUIRED in production)
#   Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# DEBUG (optional, default: False)
#   Set to True ONLY for local development.
DEBUG=False

# ALLOWED_HOSTS (REQUIRED in production)
#   Comma-separated list of domains that can serve this app.
#   Example: your-app.onrender.com,api.yourdomain.com
ALLOWED_HOSTS=your-app.onrender.com

# DATABASE_URL (REQUIRED in production)
#   PostgreSQL connection string from your database provider.
#   Example: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS_ALLOWED_ORIGINS (REQUIRED in production)
#   Comma-separated list of frontend URLs allowed to call this API.
#   Example: https://yourusername.github.io,https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourusername.github.io

# CSRF_TRUSTED_ORIGINS (REQUIRED in production)
#   Comma-separated list of trusted origins for CSRF.
#   Usually the same as CORS_ALLOWED_ORIGINS plus your backend URL.
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://yourusername.github.io

# SECURE_SSL_REDIRECT (optional, default: True in production)
#   Set to False if your hosting provider handles SSL termination with health checks
#   that use HTTP (e.g., Render). Most providers need this as True.
# SECURE_SSL_REDIRECT=True
