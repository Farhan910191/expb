# ──────────────────────────────────────────────
# Backend Environment Variables (.env.example)
# ──────────────────────────────────────────────
# On Vercel: Settings → Environment Variables → add each one below.
# Locally:   Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────

# SECRET_KEY — cryptographic signing key (NEVER commit the real value)
#   Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# DATABASE_URL — PostgreSQL connection string
#   Free hosted options: Neon (neon.tech), Supabase, or Vercel Postgres
#   Format: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ALLOWED_HOSTS — comma-separated domains
#   Must include your Vercel backend URL
ALLOWED_HOSTS=your-backend.vercel.app

# CORS_ALLOWED_ORIGINS — comma-separated frontend URLs
#   The React frontend URL(s) that call this API
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# CSRF_TRUSTED_ORIGINS — comma-separated trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://your-backend.vercel.app,https://your-frontend.vercel.app

# ── OPTIONAL ─────────────────────────────────

# DEBUG — set to True ONLY for local development (default: True)
DEBUG=False

# SECURE_SSL_REDIRECT — MUST be False on Vercel (Vercel terminates SSL at edge)
#   Setting to True causes infinite redirect loops on Vercel.
SECURE_SSL_REDIRECT=False
